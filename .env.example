# 复制成 .env 后填入自己的值，.env 不要提交到 git

# 聊天模型（任何 OpenAI 兼容服务都行）
# 默认指向 DeepSeek；改成硅基流动就能用同一把密钥跑免费模型
NUXT_DEEPSEEK_KEY=
# NUXT_CHAT_KEY=          # 不填就复用 NUXT_DEEPSEEK_KEY
# NUXT_CHAT_BASE=https://api.deepseek.com
# NUXT_CHAT_MODEL=deepseek-chat
# 例：用硅基流动的免费模型
# NUXT_CHAT_BASE=https://api.siliconflow.cn/v1
# NUXT_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# 向量化接口（硅基流动的 BGE-M3，1024 维，免费）
# 换服务商时改 NUXT_EMBEDDING_BASE，换模型时注意维度会变、已存的向量要重算
NUXT_EMBEDDING_KEY=
# NUXT_EMBEDDING_BASE=https://api.siliconflow.cn/v1
# NUXT_EMBEDDING_MODEL=BAAI/bge-m3

# Supabase：Project URL 与 Secret key（仅在服务端使用）
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# 直连数据库（Python 后端用）。注意：service key 不能当数据库密码用，
# 这里必须是完整的 Postgres 连接串；密码在 Project Settings → Database 里重置。
# 端口用 5432 直连，不要用 6543 池化器 —— transaction 模式下 asyncpg 的
# prepared statement 会冲突（见 MIGRATION-PYTHON.md 3.3）。
# NUXT_SUPABASE_DB_URL=postgresql://postgres:<密码>@db.<项目ref>.supabase.co:5432/postgres
# 后台任务用的角色（带 BYPASSRLS）。不填就复用上面那条。
# NUXT_SUPABASE_DB_ADMIN_URL=

# ============ B 档迁移开关（Python 后端）============
# 启动 Python 后端：.venv/bin/uvicorn api.main:app --reload --port 8000
# 设了地址之后，/api/* 会转发给它；留空则完全走原来的 TS 实现。
# NUXT_PY_BACKEND_URL=http://127.0.0.1:8000
# 只转发这些路径前缀（逗号分隔）；留空 = 全部转发。
# 迁移期建议一条一条加，出问题从白名单里删掉即回退。
# NUXT_PY_BACKEND_PATHS=/api/health

# 检索参数（可选）：取回几块、低于多少分算没找到
# NUXT_RAG_TOP_K=6
# NUXT_RAG_THRESHOLD=0.35

# 限流（令牌桶，按「用户 + 动作」计数）。本地压测嫌烦可以关掉
# NUXT_RATE_LIMIT_ENABLED=true
# NUXT_RATE_LIMIT_CHAT_PER_MIN=30
# NUXT_RATE_LIMIT_CHAT_BURST=20

# 后台任务：失败自动重试几次、退避基准秒数（30 → 60 → 120），超过就进死信
# NUXT_JOBS_MAX_ATTEMPTS=3
# NUXT_JOBS_RETRY_BASE_SEC=30

# 告警 webhook（飞书/钉钉/Slack 机器人，收 JSON）。不配就只打结构化日志
# NUXT_ALERT_WEBHOOK=

# 分片上传合并后的单文件上限（MB）
# NUXT_MAX_UPLOAD_MB=40
